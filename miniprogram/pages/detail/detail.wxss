page {
  background: #faf7f2;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #2a3027;
}

.page {
  min-height: 100vh;
}

.detail-head {
  position: relative;
  padding: 40rpx 40rpx 56rpx;
  text-align: center;
}

.back-btn {
  position: absolute;
  left: 24rpx;
  top: 32rpx;
  padding: 12rpx 30rpx;
  border-radius: 100rpx;
  background: #ffffff;
  border: 1rpx solid #d8ddd2;
  font-size: 26rpx;
  font-weight: 600;
  color: #2a3027;
}

.detail-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2a3027;
  margin-bottom: 12rpx;
}

.detail-meta {
  font-size: 24rpx;
  color: #889281;
}

.detail-imgs {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx 80rpx;
}

.detail-fig {
  width: 100%;
  max-width: 620rpx;
  margin-bottom: 48rpx;
}

.detail-img {
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 30, 23, 0.12);
}

.detail-caption {
  display: block;
  text-align: center;
  color: #889281;
  font-size: 22rpx;
  margin-top: 12rpx;
}
